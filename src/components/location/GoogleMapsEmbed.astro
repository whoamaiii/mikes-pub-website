---
import type { LinkTarget, VenueLocation } from '../../types/design-system';

interface Props {
  id: string;
  location: VenueLocation;
  directions: LinkTarget;
}

const { id, location, directions } = Astro.props;
const embedSrc =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2014.067482372028!2d10.526875400000002!3d59.681803499999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x46414700458fc5b5%3A0x857bef11ca0e1ee6!2sMike%27s%20Pub!5e0!3m2!1sno!2sno!4v1784895561115!5m2!1sno!2sno';
---

<figure
  class="venue-map google-map-embed"
  aria-labelledby={`${id}-caption`}
  data-map-source="official-google-maps-embed"
  data-map-state="ready"
>
  <div class="google-map-canvas" data-map-canvas>
    <iframe
      src={embedSrc}
      title={`Google Maps-kart som viser ${location.name} i ${location.street}`}
      width="600"
      height="450"
      loading="eager"
      referrerpolicy="no-referrer"
      allowfullscreen></iframe>
  </div>
  <div class="google-map-controls" data-map-controls>
    <p>Google mottar IP-adressen din og nettleserinformasjon når kartet lastes.</p>
    <button class="button" type="button" data-map-retry hidden>Prøv igjen</button>
    <a
      href={directions.href}
      rel="noopener noreferrer"
      data-external="true"
      aria-label="Åpne i Google Maps (ekstern lenke)">Åpne i Google Maps ↗</a
    >
  </div>
  <figcaption id={`${id}-caption`} class="visually-hidden">
    Offisielt Google Maps-kart som viser {location.name} i {location.street}. Google-logo, kartdata,
    vilkår og kreditering vises i selve kartet.
  </figcaption>
  <p class="google-map-status" aria-live="polite" data-map-status></p>
</figure>

<script>
  import { initializeGoogleMapEmbeds } from '../../scripts/google-map-embed';

  const initialize = () => initializeGoogleMapEmbeds();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    initialize();
  }

  window.addEventListener('pageshow', initialize);
</script>
