---
import { Image } from 'astro:assets';

import type { HomeVenueGalleryContent } from '../../types/home';

interface Props extends HomeVenueGalleryContent {
  id: string;
}

const { id, kicker, heading, items } = Astro.props;
---

<section class="home-gallery" id={id} aria-labelledby={`${id}-heading`} data-reveal>
  <div class="home-gallery-header home-section-header">
    <p class="home-section-kicker">{kicker}</p>
    <h2 id={`${id}-heading`}>{heading}</h2>
  </div>

  <div class="home-gallery-grid">
    {
      items.map((item) => (
        <figure class={`home-gallery-item home-gallery-item-${item.id}`}>
          <a
            class="home-gallery-link"
            href={item.source.href}
            aria-label={`${item.source.label} (åpnes i ny fane)`}
            target="_blank"
            rel="noopener noreferrer"
            data-external="true"
            data-rights-status={item.rightsStatus}
          >
            <Image
              src={item.image}
              alt={item.alt}
              widths={[320, 480, 640, 800, 960, 1152]}
              sizes="(min-width: 64rem) 40vw, (min-width: 48rem) 50vw, 100vw"
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span>{item.caption}</span>
              <span aria-hidden="true">↗</span>
            </figcaption>
          </a>
        </figure>
      ))
    }
  </div>
</section>
